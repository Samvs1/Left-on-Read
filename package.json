{
  "name": "left-on-read",
  "private": true,
  "version": "1.0.0",
  "description": "Left on Read: a private, in-browser chat analytics experience. Works with WhatsApp chat exports.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run build:ssr && vite build && node -e \"require('fs').rmSync('dist-ssr',{recursive:true,force:true})\"",
    "build:fast": "npm run build:ssr && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "rolldown scripts/bench.ts --format esm --platform node --file node_modules/.cache/bench.mjs --log-level silent && node node_modules/.cache/bench.mjs",
    "verify:network": "node scripts/verify-no-network.cjs",
    "lighthouse": "node scripts/lighthouse.cjs",
    "build:ssr": "vite build --ssr src/ui/entry-server.tsx --outDir dist-ssr",
    "deploy:gh-pages": "BASE_PATH=/Left-on-Read/ npm run build && gh-pages -d dist --dotfiles",
    "deploy:netlify": "npm run build && npx netlify-cli deploy --prod --dir=dist",
    "assets": "node scripts/generate-assets.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "comlink": "^4.4.2",
    "echarts": "^6.1.0",
    "framer-motion": "^12.43.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.2",
    "mediabunny": "^1.65.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "workbox-build": "^7.4.1"
  }
}
